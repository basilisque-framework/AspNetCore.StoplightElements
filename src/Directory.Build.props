<Project>
  <!-- general build properties -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <PackageId>Basilisque.$(MSBuildProjectName)</PackageId>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Pack README -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="docs" Visible="false" />
  </ItemGroup>
  
  <!-- NuGet package properties and project info -->
  <PropertyGroup>
    <BAS_CB_Copyright_BeginYear>2026</BAS_CB_Copyright_BeginYear>
    <PackageProjectUrl>https://github.com/basilisque-framework/AspNetCore.StoplightElements</PackageProjectUrl>
    <PackageTags>WebAPI Stoplight Elements OpenAPI OpenAPI-UI OpenAPIUI aspnetcore swagger api-documentation</PackageTags>
    <!--<PackageIconUrl>http://www.url.de/nuget_icon.png</PackageIconUrl>-->
    <PackageReadmeFile>docs\README.md</PackageReadmeFile>
    <Description>ASP.NET Core integration for locally hosted Stoplight Elements documentation.</Description>
  </PropertyGroup>

  <!-- common build configuration for non-test projects -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) != 'true'">
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>$(MSBuildProjectName).Unit.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  
  <!-- common build configuration for unit test projects -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Unit.Tests'))">
    <ProjectReference Include="..\$(MSBuildProjectName.Replace('.Unit.Tests', ''))\$(MSBuildProjectName.Replace('.Unit.Tests', '')).csproj" />

    <PackageReference Include="NSubstitute" />

    <Using Include="NSubstitute"/>
  </ItemGroup>
</Project>
<Project>
  <PropertyGroup>
    <!-- 
      Default version string if not specified in the target project.
      Supported values:
        - "latest" (default: resolves to the newest available release)
        - Major pinning (e.g., "8" or "^8": receives non-breaking minor/patch updates)
        - Major.Minor pinning (e.g., "8.0" or "~8.0": receives patch updates only)
        - Exact version (e.g., "8.0.0": locks down to a specific release)
    -->
    <StoplightElementsVersion Condition="'$(StoplightElementsVersion)' == ''">latest</StoplightElementsVersion>
  </PropertyGroup>

  <!-- Define default assets list if not overridden or populated by the target project -->
  <ItemGroup Condition="'@(StoplightAsset)' == ''">
    <StoplightAsset Include="web-components.min.js" />
    <StoplightAsset Include="styles.min.css" />
    <StoplightAsset Include="web-components.min.js.LICENSE.txt" />
  </ItemGroup>

  <Target Name="FetchStoplightAssets" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <!-- Asset cache directory inside obj/ scoped to the selected version specifier -->
      <StoplightCacheDir>$(IntermediateOutputPath)stoplight-assets\$(StoplightElementsVersion)\</StoplightCacheDir>
    </PropertyGroup>
    
    <MakeDir Directories="$(StoplightCacheDir)" />

    <!-- Download each configured asset if not already cached in obj/ -->
    <DownloadFile
      SourceUrl="https://unpkg.com/@stoplight/elements@$(StoplightElementsVersion)/%(StoplightAsset.Identity)"
      DestinationFolder="$(StoplightCacheDir)"
      Condition="!Exists('$(StoplightCacheDir)%(StoplightAsset.Identity)')" />

    <!-- Dynamically embed all downloaded assets into the target assembly -->
    <ItemGroup>
      <EmbeddedResource Include="$(StoplightCacheDir)%(StoplightAsset.Identity)">
        <LogicalName>StoplightAssets.%(StoplightAsset.Identity)</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <!--
      Manually import project and build props/targets. In a real application this is not necessary.
      Instead this would be a normal NuGet PackageReference
    -->
  <!-- BEGIN -->
  <ItemGroup>
    <ProjectReference Include="..\AspNetCore.StoplightElements\AspNetCore.StoplightElements.csproj" />
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)../AspNetCore.StoplightElements/build/**" />
  <!-- END -->
</Project>